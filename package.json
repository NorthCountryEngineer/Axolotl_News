{
  "name": "axolotl-news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p amplify/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/check-config.mjs && npm run typecheck && vite build --mode production",
    "build:preview": "tsc --noEmit && node scripts/build-preview.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "aws-amplify": "6.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.8.0",
    "@aws-amplify/backend-cli": "1.4.2",
    "@types/node": "20.17.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "aws-cdk-lib": "2.170.0",
    "constructs": "10.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "overrides": {
    "@aws-cdk/asset-awscli-v1": "2.2.212",
    "@whatwg-node/node-fetch": "0.7.3",
    "@aws-sdk/middleware-flexible-checksums": "3.697.0",
    "@aws-sdk/client-cloudwatch-logs": "3.699.0",
    "@graphql-tools/apollo-engine-loader": "8.0.5",
    "@types/aws-lambda": "8.10.145",
    "@aws-amplify/backend-deployer": "1.1.9",
    "@aws-amplify/platform-core": "1.2.1",
    "@aws-sdk/client-s3": "3.699.0",
    "@graphql-tools/utils@^10.0.0": "10.6.0",
    "@graphql-tools/schema@^10.0.0": "10.0.9",
    "@graphql-tools/merge@^9.0.0": "9.0.10"
  }
}
