{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Axolotl News Core-bound serverless API and private assistant state; paid AI and media analysis disabled by default.",
  "Parameters": {
    "ApplicationOrigin": {
      "Type": "String",
      "AllowedPattern": "^https://[a-zA-Z0-9.-]+$",
      "Default": "https://axolotl.news"
    },
    "CoreIssuer": {
      "Type": "String",
      "AllowedPattern": "^https://[a-zA-Z0-9.-]+$"
    },
    "CoreOrganizationId": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9-]{36}$"
    },
    "CoreServiceId": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9-]{36}$"
    },
    "CoreCredentialsParameter": {
      "Type": "String",
      "AllowedPattern": "^/[a-zA-Z0-9/_-]+$",
      "Default": "/axolotl-news/core-resource-client"
    },
    "LambdaCodeBucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9.-]+$"
    },
    "LambdaCodeKey": {
      "Type": "String",
      "AllowedPattern": "^[a-zA-Z0-9/_.-]+$",
      "Default": "axolotl-api.zip"
    },
    "LambdaReservedConcurrency": {
      "Type": "Number",
      "Default": 2,
      "AllowedValues": [
        0,
        1,
        2
      ],
      "Description": "2 for bounded concurrency; 0 omits a reservation if the account quota cannot preserve 100 unreserved executions. Not a bill cap."
    },
    "AllowPaidModels": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Explicit operator opt-in for paid model calls; application configuration must also permit them. Not a bill cap."
    },
    "EnableMediaModels": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Additional operator opt-in for Rekognition image/video label detection; requires AllowPaidModels=true."
    },
    "BedrockModelAllowlist": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]*(,[A-Za-z0-9][A-Za-z0-9._:/-]*)*$",
      "MaxLength": 1024,
      "Description": "Exact comma-separated Bedrock invocation target IDs or ARNs; no spaces or wildcards. Empty blocks Bedrock calls."
    },
    "BedrockResourceArns": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws[a-z-]*:bedrock:[a-z0-9-]*:[0-9]*:(foundation-model|inference-profile|application-inference-profile)/[A-Za-z0-9._:/-]+(,arn:aws[a-z-]*:bedrock:[a-z0-9-]*:[0-9]*:(foundation-model|inference-profile|application-inference-profile)/[A-Za-z0-9._:/-]+)*$",
      "MaxLength": 4096,
      "Description": "Exact comma-separated Bedrock IAM ARNs, no wildcard. Include profile ARN and every destination foundation-model ARN when using inference profiles."
    }
  },
  "Resources": {
    "PrivatePosts": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "PublishedPosts": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "Media": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": [
                {
                  "Ref": "ApplicationOrigin"
                }
              ],
              "AllowedHeaders": [
                "*"
              ],
              "AllowedMethods": [
                "GET",
                "HEAD",
                "POST"
              ],
              "ExposedHeaders": [
                "ETag"
              ],
              "MaxAge": 300
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "MediaTLS": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Media"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Media",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Media.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "NewsroomOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Scan",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "PrivatePosts",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "PublishedPosts",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Media.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Media",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${CoreCredentialsParameter}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ApiLogGroup.Arn}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${AWS::Region}:${AWS::AccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      },
                      "kms:EncryptionContext:PARAMETER_ARN": {
                        "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${CoreCredentialsParameter}"
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "AssistantStateOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AssistantState",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "BedrockModelsEnabled",
              {
                "PolicyName": "ExplicitBedrockModelsOnly",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": "bedrock:InvokeModel",
                      "Resource": {
                        "Fn::Split": [
                          ",",
                          {
                            "Ref": "BedrockResourceArns"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "MediaModelsEnabled",
              {
                "PolicyName": "ExplicitMediaLabelsOnly",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": [
                        "rekognition:DetectLabels",
                        "rekognition:StartLabelDetection",
                        "rekognition:GetLabelDetection"
                      ],
                      "Resource": "*",
                      "Condition": {
                        "StringEquals": {
                          "aws:RequestedRegion": {
                            "Ref": "AWS::Region"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Extend existing API identity only for isolated assistant persistence and opted-in exact model operations.",
          "must": [
            "Assistant persistence is limited to the separate state table.",
            "No Bedrock permission without paid opt-in and nonempty exact target/resource lists.",
            "Rekognition labels require both paid and media opt-ins; no training, face or project permissions."
          ],
          "mutable": "change-with-constraints"
        }
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "handler.handler",
        "MemorySize": 256,
        "Timeout": 30,
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "ReserveConcurrency",
            {
              "Ref": "LambdaReservedConcurrency"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeBucket"
          },
          "S3Key": {
            "Ref": "LambdaCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "PRIVATE_TABLE": {
              "Ref": "PrivatePosts"
            },
            "PUBLIC_TABLE": {
              "Ref": "PublishedPosts"
            },
            "MEDIA_BUCKET": {
              "Ref": "Media"
            },
            "CORE_ISSUER": {
              "Ref": "CoreIssuer"
            },
            "CORE_ORGANIZATION_ID": {
              "Ref": "CoreOrganizationId"
            },
            "CORE_SERVICE_ID": {
              "Ref": "CoreServiceId"
            },
            "CORE_CREDENTIALS_PARAMETER": {
              "Ref": "CoreCredentialsParameter"
            },
            "ASSISTANT_TABLE": {
              "Ref": "AssistantState"
            },
            "ALLOW_PAID_MODELS": {
              "Ref": "AllowPaidModels"
            },
            "REKOGNITION_ENABLED": {
              "Ref": "EnableMediaModels"
            },
            "BEDROCK_MODEL_ALLOWLIST": {
              "Fn::If": [
                "BedrockModelsEnabled",
                {
                  "Ref": "BedrockModelAllowlist"
                },
                ""
              ]
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reuse current bounded API runtime; persist assistant state separately and never enable model traffic through frontend settings alone.",
          "must": [
            "Do not change existing Core credentials or content/media bindings.",
            "Paid and media gates default off.",
            "No model/background operation may outlive the request without a persisted checkpoint."
          ],
          "mutable": "change-with-constraints"
        }
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Ref": "ApplicationOrigin"
            }
          ],
          "AllowHeaders": [
            "authorization",
            "content-type"
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "OPTIONS"
          ],
          "MaxAge": 300
        }
      }
    },
    "ApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 30000
      }
    },
    "ApiRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${ApiIntegration}"
        }
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        }
      }
    },
    "ApiPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*"
        }
      }
    },
    "AssistantState": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate private assistant configuration and owner-bound sessions from content/public projections.",
          "must": [
            "Never expose through public posts scans or public media.",
            "Retain state on stack deletion or replacement."
          ],
          "mutable": "change-with-constraints"
        }
      },
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "MediaBucket": {
      "Value": {
        "Ref": "Media"
      }
    },
    "PrivateTable": {
      "Value": {
        "Ref": "PrivatePosts"
      }
    },
    "PublishedTable": {
      "Value": {
        "Ref": "PublishedPosts"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "ApiFunction"
      }
    },
    "AssistantTable": {
      "Value": {
        "Ref": "AssistantState"
      }
    }
  },
  "Conditions": {
    "ReserveConcurrency": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "LambdaReservedConcurrency"
            },
            0
          ]
        }
      ]
    },
    "PaidModelsEnabled": {
      "Fn::Equals": [
        {
          "Ref": "AllowPaidModels"
        },
        "true"
      ]
    },
    "BedrockTargetsConfigured": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "BedrockModelAllowlist"
            },
            ""
          ]
        }
      ]
    },
    "BedrockResourcesConfigured": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "BedrockResourceArns"
            },
            ""
          ]
        }
      ]
    },
    "BedrockModelsEnabled": {
      "Fn::And": [
        {
          "Condition": "PaidModelsEnabled"
        },
        {
          "Condition": "BedrockTargetsConfigured"
        },
        {
          "Condition": "BedrockResourcesConfigured"
        }
      ]
    },
    "MediaModelsEnabled": {
      "Fn::And": [
        {
          "Condition": "PaidModelsEnabled"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableMediaModels"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "arch": "HTTP API -> Core-authorized Lambda -> separate draft, publication and assistant tables + private media; optional explicit model calls.",
      "must": [
        "Preserve existing content tables and media bucket when updating.",
        "Paid model execution requires stack opt-in and administrator configuration."
      ],
      "ref": [
        {
          "at": "docs/AGENT_WORKFLOWS.md",
          "has": "assistant access, model allowlists, retained state and backend-first release",
          "scope": "assistant"
        }
      ]
    }
  }
}
